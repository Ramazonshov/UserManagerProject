<Window x:Class="Project1.Users"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project1"
        mc:Ignorable="d"
        Title="Пользователи" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#FFF0F0F0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Пользователи" FontSize="24" HorizontalAlignment="Center" Margin="10"/>
        <!-- Замени старую кнопку на эту -->
        <Button Content="Добавить пользователя"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="20,10,0,0"
        Padding="12,6"
        FontSize="14"
        Background="#FF4CAF50"
        Foreground="White"
        Cursor="Hand"
        x:Name="btnAdd"
        Click="BtnAdd_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="#FF388E3C"
                                BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF388E3C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#FF2E7D32"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <StackPanel Grid.Column="1" Margin="15,20,15,0">
            <TextBlock Text="Доп. функции" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Сортировка"/>
            <ComboBox x:Name="cmbSort" Margin="0,5,0,15" SelectionChanged="cmbSort_SelectionChanged">
                <ComboBoxItem IsSelected="True">А-Я</ComboBoxItem>
                <ComboBoxItem>Я-А</ComboBoxItem>
            </ComboBox>

            <CheckBox x:Name="chkFilter" Content="вкл/выкл фильтрация" Margin="0,0,0,10"
              Checked="chkFilter_Checked" Unchecked="chkFilter_Unchecked"/>

            <TextBlock Text="Фильтрация по роли"/>
            <ComboBox x:Name="cmbFilterRole" Margin="0,5,0,0" 
              SelectionChanged="cmbFilterRole_SelectionChanged"/>
        </StackPanel>

        <DataGrid x:Name="dgUsers" Grid.Row="1" Grid.ColumnSpan="2"
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="20"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="2*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role.Title}" Width="1*"/>
                <DataGridTemplateColumn Header="Действия" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Изменить" Margin="5" Padding="10,5"
                                        Click="BtnEdit_Click" Tag="{Binding}"/>
                                <Button Content="Удалить" Margin="5" Padding="10,5"
                                        Background="#FFF44336" Foreground="White"
                                        Click="BtnDelete_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="20"
                   Text="Количество пользователей по ролям:" FontSize="14"/>
    </Grid>
</Window>
