<Window x:Class="Project1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project1"
        mc:Ignorable="d"
        Title="Авторизация" Height="320" Width="380"
        
        WindowStartupLocation="CenterScreen" Background="LightSteelBlue">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock  Text="Логин :" FontSize="14" Margin="0,0,0,5"/>
        <TextBox x:Name="tb_login" Grid.Row="0" Height="30" FontSize="15" Padding="5" Margin="52,0,0,0"/>

        <TextBlock Text="Пароль :" Grid.Row="1" FontSize="15" Margin="0,15,0,5"/>
        <PasswordBox x:Name="pb_password" Grid.Row="1" Height="30" FontSize="14" Padding="5" Margin="78,4,0,5"/>

        <StackPanel Grid.Row="2" Margin="0,30,0,0">
            <Button Content="Авторизация" Height="40" Margin="0,0,0,10" 
                    Background="#FF4CAF50" Foreground="White" FontSize="16"
                    Click="BtnLogin_Click"/>
            <Button Content="Регистрация" Height="40" Margin="0,0,0,10" 
                    Background="#FF2196F3" Foreground="White" FontSize="16"
                    Click="BtnRegister_Click"/>
            <Button Content="Войти гостем" Height="40" 
                    Background="#FF9E9E9E" Foreground="White" FontSize="16"
                    Click="BtnGuest_Click"/>
        </StackPanel>
    </Grid>
</Window>
