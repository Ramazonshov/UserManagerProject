<Window x:Class="Project1.UserAddEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project1"
        mc:Ignorable="d"
        Title="Заголовок" Height="430" Width="300"
        WindowStartupLocation="CenterOwner" Background="#FFFFF3E0">
    <Grid >
        <StackPanel Margin="20">
            <TextBlock x:Name="txtTitle" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин"/>
            <TextBox x:Name="txtLogin" Height="30" Margin="0,5"/>

            <TextBlock Text="Пароль" Margin="0,15,0,5"/>
            <PasswordBox x:Name="txtPass" Height="30"/>

            <TextBlock Text="Повторите пароль" Margin="0,10,0,5"/>
            <PasswordBox x:Name="txtPass2" Height="30"/>

            <TextBlock Text="Роль" Margin="0,15,0,5"/>
            <ComboBox x:Name="cmRole" Height="30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30">
                <Button Content="Сохранить" Width="100" Height="40" Margin="10"
                    Background="#FF4CAF50" Foreground="White" Click="BtnSave_Click"/>
                <Button Content="Отмена" Width="100" Height="40" Margin="10"
                    Background="#FFB0BEC5" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
